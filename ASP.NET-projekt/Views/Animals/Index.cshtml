@model IEnumerable<ASP.NET_projekt.ViewModels.AnimalListItemViewModel>
@{
    ViewData["Title"] = "All Animals";
}

<section class="entity-page">
    <header class="entity-header">
        <div>
            <h1 class="entity-title">All Animals</h1>
            <p class="entity-subtitle">Browse every animal in the zoo and open a profile for full details.</p>
        </div>
        <div class="entity-actions">
            <a href="@Url.Action("Create")" class="btn btn-primary">+ Add New Animal</a>
            <span class="entity-count-badge" id="animalCountBadge">@Model.Count() animals</span>
        </div>
    </header>

    <div style="margin-bottom: 20px; max-width: 420px;">
        <input type="text" id="animalSearchInput" class="form-control" placeholder="Search animals by name or species..." value="@ViewBag.SearchQuery">
    </div>

    <div class="entity-grid" id="animalsGrid">
        @{ var index = 0; }
        @foreach (var animal in Model)
        {
            <article class="entity-card" style="animation-delay:@(index * 40)ms">
                <div class="entity-card__head">
                    <h2 class="entity-card__title">@animal.Name</h2>
                    <p class="entity-card__subtitle">@animal.Species</p>
                </div>

                <div class="entity-card__chips">
                    <span class="entity-chip entity-chip--diet entity-chip--diet-@animal.Diet.ToString().ToLowerInvariant()">@animal.Diet</span>
                    <span class="entity-chip @(animal.MedicalRecordsCount > 0 ? "entity-chip--success" : "entity-chip--warning")">
                        @(animal.MedicalRecordsCount > 0 ? "Medical history available" : "No medical records")
                    </span>
                </div>

                <dl class="entity-card__meta">
                    <div class="entity-meta-row">
                        <dt class="entity-meta-label">Age</dt>
                        <dd class="entity-meta-value">@animal.Age years</dd>
                    </div>
                    <div class="entity-meta-row">
                        <dt class="entity-meta-label">Enclosure</dt>
                        <dd class="entity-meta-value">@animal.EnclosureName</dd>
                    </div>
                </dl>

                <div class="entity-card__footer" style="display: flex; gap: 8px; justify-content: space-between;">
                    <a class="card-link entity-link" asp-controller="Animals" asp-action="Details" asp-route-id="@animal.Id">View details</a>
                    <div>
                        <a href="@Url.Action("Edit", new { id = animal.Id })" class="btn btn-warning btn-sm">Edit</a>
                        <a href="@Url.Action("Delete", new { id = animal.Id })" class="btn btn-danger btn-sm">Delete</a>
                    </div>
                </div>
            </article>
            index++;
        }
    </div>
</section>

@section Scripts {
    <script>
        const animalSearchInput = document.getElementById('animalSearchInput');
        const animalsGrid = document.getElementById('animalsGrid');
        const animalCountBadge = document.getElementById('animalCountBadge');
        const searchUrl = '@Url.Action("Search", "Animals")';
        const detailUrlTemplate = '@Url.Action("Details", "Animals", new { id = "__id__" })';
        const editUrlTemplate = '@Url.Action("Edit", "Animals", new { id = "__id__" })';
        const deleteUrlTemplate = '@Url.Action("Delete", "Animals", new { id = "__id__" })';
        let searchTimer = null;

        function escapeHtml(value) {
            return String(value)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');
        }

        function buildAnimalCard(animal, index) {
            const dietClass = `entity-chip--diet-${animal.diet.toLowerCase()}`;
            const medicalStatusClass = animal.medicalRecordsCount > 0 ? 'entity-chip--success' : 'entity-chip--warning';
            const medicalStatusText = animal.medicalRecordsCount > 0 ? 'Medical history available' : 'No medical records';
            const detailsUrl = detailUrlTemplate.replace('__id__', animal.id);
            const editUrl = editUrlTemplate.replace('__id__', animal.id);
            const deleteUrl = deleteUrlTemplate.replace('__id__', animal.id);

            return `
                <article class="entity-card" style="animation-delay:${index * 40}ms">
                    <div class="entity-card__head">
                        <h2 class="entity-card__title">${escapeHtml(animal.name)}</h2>
                        <p class="entity-card__subtitle">${escapeHtml(animal.species)}</p>
                    </div>

                    <div class="entity-card__chips">
                        <span class="entity-chip entity-chip--diet ${dietClass}">${escapeHtml(animal.diet)}</span>
                        <span class="entity-chip ${medicalStatusClass}">${medicalStatusText}</span>
                    </div>

                    <dl class="entity-card__meta">
                        <div class="entity-meta-row">
                            <dt class="entity-meta-label">Age</dt>
                            <dd class="entity-meta-value">${animal.age} years</dd>
                        </div>
                        <div class="entity-meta-row">
                            <dt class="entity-meta-label">Enclosure</dt>
                            <dd class="entity-meta-value">${escapeHtml(animal.enclosureName)}</dd>
                        </div>
                    </dl>

                    <div class="entity-card__footer" style="display: flex; gap: 8px; justify-content: space-between;">
                        <a class="card-link entity-link" href="${detailsUrl}">View details</a>
                        <div>
                            <a href="${editUrl}" class="btn btn-warning btn-sm">Edit</a>
                            <a href="${deleteUrl}" class="btn btn-danger btn-sm">Delete</a>
                        </div>
                    </div>
                </article>
            `;
        }

        function updateAnimals(query) {
            fetch(`${searchUrl}?query=${encodeURIComponent(query)}`)
                .then(response => response.json())
                .then(animals => {
                    animalCountBadge.textContent = `${animals.length} animals`;

                    if (animals.length === 0) {
                        animalsGrid.innerHTML = '<p style="grid-column: 1 / -1;">No animals found.</p>';
                        return;
                    }

                    animalsGrid.innerHTML = animals.map((animal, index) => buildAnimalCard(animal, index)).join('');
                })
                .catch(() => {
                    animalsGrid.innerHTML = '<p style="grid-column: 1 / -1;">Search failed. Please try again.</p>';
                });
        }

        animalSearchInput.addEventListener('input', () => {
            window.clearTimeout(searchTimer);
            searchTimer = window.setTimeout(() => updateAnimals(animalSearchInput.value), 200);
        });
    </script>
}

