@model IEnumerable<ASP.NET_projekt.ViewModels.EnclosureListItemViewModel>
@{
    ViewData["Title"] = "All Enclosures";
}

<section class="entity-page">
    <header class="entity-header">
        <div>
            <h1 class="entity-title">All Enclosures</h1>
            <p class="entity-subtitle">View every habitat in the zoo, with occupancy and assigned care staff.</p>
        </div>
        <div class="entity-actions">
            <a href="@Url.Action("Create", "Enclosures")" class="btn btn-primary btn-sm">Add Enclosure</a>
            <span class="entity-count-badge" id="enclosureCountBadge">@Model.Count() enclosures</span>
        </div>
    </header>

    <div style="margin-bottom: 20px; max-width: 420px;">
        <input type="text" id="enclosureSearchInput" class="form-control" placeholder="Search enclosures by name, zoo, type, or zookeeper...">
    </div>

    <div class="entity-grid" id="enclosureGrid">
        @{ var index = 0; }
        @foreach (var enclosure in Model)
        {
            <article class="entity-card" style="animation-delay:@(index * 40)ms">
                <div class="entity-card__head">
                    <h2 class="entity-card__title">@enclosure.Name</h2>
                    <p class="entity-card__subtitle">@enclosure.ZooName</p>
                </div>

                <div class="entity-card__chips">
                    <span class="entity-chip entity-chip--role">@enclosure.Type</span>
                    <span class="entity-chip @enclosure.OccupancyStatusClass">@enclosure.OccupancyStatusText</span>
                </div>

                <dl class="entity-card__meta">
                    <div class="entity-meta-row">
                        <dt class="entity-meta-label">Capacity</dt>
                        <dd class="entity-meta-value">@enclosure.Capacity</dd>
                    </div>
                    <div class="entity-meta-row">
                        <dt class="entity-meta-label">Occupancy</dt>
                        <dd class="entity-meta-value">@enclosure.OccupancyDisplay</dd>
                    </div>
                    <div class="entity-meta-row">
                        <dt class="entity-meta-label">Assigned zookeeper</dt>
                        <dd class="entity-meta-value">@enclosure.ZookeeperName</dd>
                    </div>
                </dl>

                <div class="entity-card__footer" style="display: flex; gap: 8px; justify-content: space-between;">
                    <a class="card-link entity-link" asp-controller="Enclosures" asp-action="Details" asp-route-id="@enclosure.Id">View details</a>
                    <div>
                        <a href="@Url.Action("Edit", "Enclosures", new { id = enclosure.Id })" class="btn btn-warning btn-sm">Edit</a>
                        <a href="@Url.Action("Delete", "Enclosures", new { id = enclosure.Id })" class="btn btn-danger btn-sm">Delete</a>
                    </div>
                </div>
            </article>
            index++;
        }
    </div>
</section>

@section Scripts {
    <script>
        const enclosureSearchInput = document.getElementById('enclosureSearchInput');
        const enclosureGrid = document.getElementById('enclosureGrid');
        const enclosureCountBadge = document.getElementById('enclosureCountBadge');
        const searchUrl = '@Url.Action("Search", "Enclosures")';
        const detailsUrlTemplate = '@Url.Action("Details", "Enclosures", new { id = "__id__" })';
        const editUrlTemplate = '@Url.Action("Edit", "Enclosures", new { id = "__id__" })';
        const deleteUrlTemplate = '@Url.Action("Delete", "Enclosures", new { id = "__id__" })';
        let enclosureSearchTimer = null;

        function escapeHtml(value) {
            return String(value)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');
        }

        function renderEnclosureCard(item, index) {
            const detailsUrl = detailsUrlTemplate.replace('__id__', item.id);
            const editUrl = editUrlTemplate.replace('__id__', item.id);
            const deleteUrl = deleteUrlTemplate.replace('__id__', item.id);

            return `
                <article class="entity-card" style="animation-delay:${index * 40}ms">
                    <div class="entity-card__head">
                        <h2 class="entity-card__title">${escapeHtml(item.name)}</h2>
                        <p class="entity-card__subtitle">${escapeHtml(item.zooName)}</p>
                    </div>

                    <div class="entity-card__chips">
                        <span class="entity-chip entity-chip--role">${escapeHtml(item.type)}</span>
                        <span class="entity-chip ${item.occupancyStatusClass}">${escapeHtml(item.occupancyStatusText)}</span>
                    </div>

                    <dl class="entity-card__meta">
                        <div class="entity-meta-row">
                            <dt class="entity-meta-label">Capacity</dt>
                            <dd class="entity-meta-value">${item.capacity}</dd>
                        </div>
                        <div class="entity-meta-row">
                            <dt class="entity-meta-label">Occupancy</dt>
                            <dd class="entity-meta-value">${escapeHtml(item.occupancyDisplay)}</dd>
                        </div>
                        <div class="entity-meta-row">
                            <dt class="entity-meta-label">Assigned zookeeper</dt>
                            <dd class="entity-meta-value">${escapeHtml(item.zookeeperName)}</dd>
                        </div>
                    </dl>

                    <div class="entity-card__footer" style="display: flex; gap: 8px; justify-content: space-between;">
                        <a class="card-link entity-link" href="${detailsUrl}">View details</a>
                        <div>
                            <a href="${editUrl}" class="btn btn-warning btn-sm">Edit</a>
                            <a href="${deleteUrl}" class="btn btn-danger btn-sm">Delete</a>
                        </div>
                    </div>
                </article>
            `;
        }

        function updateEnclosures(query) {
            fetch(`${searchUrl}?query=${encodeURIComponent(query)}`)
                .then(response => response.json())
                .then(items => {
                    enclosureCountBadge.textContent = `${items.length} enclosures`;

                    if (items.length === 0) {
                        enclosureGrid.innerHTML = '<p style="grid-column: 1 / -1;">No enclosures found.</p>';
                        return;
                    }

                    enclosureGrid.innerHTML = items.map((item, index) => renderEnclosureCard(item, index)).join('');
                })
                .catch(() => {
                    enclosureGrid.innerHTML = '<p style="grid-column: 1 / -1;">Search failed. Please try again.</p>';
                });
        }

        enclosureSearchInput.addEventListener('input', () => {
            window.clearTimeout(enclosureSearchTimer);
            enclosureSearchTimer = window.setTimeout(() => updateEnclosures(enclosureSearchInput.value), 200);
        });
    </script>
}
