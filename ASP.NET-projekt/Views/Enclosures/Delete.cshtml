@model EnclosureDetailsViewModel

@{
    ViewData["Title"] = "Delete Enclosure";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <h2>Delete Enclosure</h2>
            <hr />

            <div class="alert alert-warning" role="alert">
                <strong>Warning:</strong> Are you sure you want to delete this enclosure? This action cannot be undone.
            </div>

            <div class="card mb-4">
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-3">Name:</dt>
                        <dd class="col-sm-9">@Model.Enclosure.Name</dd>

                        <dt class="col-sm-3">Type:</dt>
                        <dd class="col-sm-9">@Model.Enclosure.Type</dd>

                        <dt class="col-sm-3">Zoo:</dt>
                        <dd class="col-sm-9">@Model.ZooName</dd>

                        <dt class="col-sm-3">Zookeeper:</dt>
                        <dd class="col-sm-9">@Model.ZookeeperName</dd>

                        <dt class="col-sm-3">Capacity:</dt>
                        <dd class="col-sm-9">@Model.Enclosure.Capacity</dd>

                        <dt class="col-sm-3">Current Animals:</dt>
                        <dd class="col-sm-9">@Model.Enclosure.Animals.Count</dd>

                        <dt class="col-sm-3">Occupancy Status:</dt>
                        <dd class="col-sm-9"><span class="entity-chip @Model.OccupancyStatusClass">@Model.OccupancyStatusText</span></dd>
                    </dl>
                </div>
            </div>

            <form asp-action="Delete" method="post" class="d-inline">
                <input type="hidden" asp-for="Enclosure.Id" />
                <button type="submit" class="btn btn-danger">Delete</button>
                <a href="@Url.Action("Index")" class="btn btn-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>
