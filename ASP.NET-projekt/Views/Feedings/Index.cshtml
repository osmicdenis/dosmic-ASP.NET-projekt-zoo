@model IEnumerable<ASP.NET_projekt.ViewModels.FeedingListItemViewModel>
@{
    ViewData["Title"] = "Feeding Schedule";
}

<section class="entity-page">
    <header class="entity-header">
        <div>
            <h1 class="entity-title">Feeding Schedule</h1>
            <p class="entity-subtitle">Track all scheduled and completed feedings across the zoo.</p>
        </div>
        <div class="entity-actions">
            <a href="@Url.Action("Create", "Feedings")" class="btn btn-primary btn-sm">Schedule Feeding</a>
            <span class="entity-count-badge" id="feedingCountBadge">@Model.Count() feedings</span>
        </div>
    </header>

    <div style="margin-bottom: 20px; max-width: 420px;">
        <input type="text" id="feedingSearchInput" class="form-control" placeholder="Search feedings by animal, food, enclosure, or zookeeper...">
    </div>

    <div class="entity-grid" id="feedingGrid">
        @{ var index = 0; }
        @foreach (var feeding in Model)
        {
            <article class="entity-card" style="animation-delay:@(index * 40)ms">
                <div class="entity-card__head">
                    <h2 class="entity-card__title">@feeding.AnimalName</h2>
                    <p class="entity-card__subtitle">@feeding.AnimalSpecies</p>
                </div>

                <div class="entity-card__chips">
                    <span class="entity-chip entity-chip--diet entity-chip--diet-@feeding.Diet.ToString().ToLowerInvariant()">@feeding.Diet</span>
                    <span class="entity-chip @feeding.StatusClass">@feeding.StatusText</span>
                </div>

                <dl class="entity-card__meta">
                    <div class="entity-meta-row">
                        <dt class="entity-meta-label">Food</dt>
                        <dd class="entity-meta-value">@feeding.FoodName</dd>
                    </div>
                    <div class="entity-meta-row">
                        <dt class="entity-meta-label">Time</dt>
                        <dd class="entity-meta-value">@feeding.FeedingTime.ToString("dd MMM yyyy HH:mm")</dd>
                    </div>
                    <div class="entity-meta-row">
                        <dt class="entity-meta-label">Enclosure</dt>
                        <dd class="entity-meta-value">@feeding.EnclosureName</dd>
                    </div>
                    <div class="entity-meta-row">
                        <dt class="entity-meta-label">Zookeeper</dt>
                        <dd class="entity-meta-value">@feeding.ZookeeperName</dd>
                    </div>
                </dl>

                <div class="entity-card__footer" style="display: flex; gap: 8px; justify-content: space-between;">
                    <a class="card-link entity-link" asp-controller="Feedings" asp-action="Details" asp-route-id="@feeding.Id">View details</a>
                    <div>
                        <a href="@Url.Action("Edit", "Feedings", new { id = feeding.Id })" class="btn btn-warning btn-sm">Edit</a>
                        <a href="@Url.Action("Delete", "Feedings", new { id = feeding.Id })" class="btn btn-danger btn-sm">Delete</a>
                    </div>
                </div>
            </article>
            index++;
        }
    </div>
</section>

@section Scripts {
    <script>
        const feedingSearchInput = document.getElementById('feedingSearchInput');
        const feedingGrid = document.getElementById('feedingGrid');
        const feedingCountBadge = document.getElementById('feedingCountBadge');
        const searchUrl = '@Url.Action("Search", "Feedings")';
        const detailsUrlTemplate = '@Url.Action("Details", "Feedings", new { id = "__id__" })';
        const editUrlTemplate = '@Url.Action("Edit", "Feedings", new { id = "__id__" })';
        const deleteUrlTemplate = '@Url.Action("Delete", "Feedings", new { id = "__id__" })';
        let feedingSearchTimer = null;

        function escapeHtml(value) {
            return String(value)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');
        }

        function formatDateTime(value) {
            const date = new Date(value);
            const pad = number => String(number).padStart(2, '0');
            const month = date.toLocaleString('en-US', { month: 'short' });
            return `${pad(date.getDate())} ${month} ${date.getFullYear()} ${pad(date.getHours())}:${pad(date.getMinutes())}`;
        }

        function renderFeedingCard(item, index) {
            const detailsUrl = detailsUrlTemplate.replace('__id__', item.id);
            const editUrl = editUrlTemplate.replace('__id__', item.id);
            const deleteUrl = deleteUrlTemplate.replace('__id__', item.id);
            const dietClass = `entity-chip--diet-${item.diet.toLowerCase()}`;

            return `
                <article class="entity-card" style="animation-delay:${index * 40}ms">
                    <div class="entity-card__head">
                        <h2 class="entity-card__title">${escapeHtml(item.animalName)}</h2>
                        <p class="entity-card__subtitle">${escapeHtml(item.animalSpecies)}</p>
                    </div>

                    <div class="entity-card__chips">
                        <span class="entity-chip entity-chip--diet ${dietClass}">${escapeHtml(item.diet)}</span>
                        <span class="entity-chip ${item.statusClass}">${escapeHtml(item.statusText)}</span>
                    </div>

                    <dl class="entity-card__meta">
                        <div class="entity-meta-row">
                            <dt class="entity-meta-label">Food</dt>
                            <dd class="entity-meta-value">${escapeHtml(item.foodName)}</dd>
                        </div>
                        <div class="entity-meta-row">
                            <dt class="entity-meta-label">Time</dt>
                            <dd class="entity-meta-value">${formatDateTime(item.feedingTime)}</dd>
                        </div>
                        <div class="entity-meta-row">
                            <dt class="entity-meta-label">Enclosure</dt>
                            <dd class="entity-meta-value">${escapeHtml(item.enclosureName)}</dd>
                        </div>
                        <div class="entity-meta-row">
                            <dt class="entity-meta-label">Zookeeper</dt>
                            <dd class="entity-meta-value">${escapeHtml(item.zookeeperName)}</dd>
                        </div>
                    </dl>

                    <div class="entity-card__footer" style="display: flex; gap: 8px; justify-content: space-between;">
                        <a class="card-link entity-link" href="${detailsUrl}">View details</a>
                        <div>
                            <a href="${editUrl}" class="btn btn-warning btn-sm">Edit</a>
                            <a href="${deleteUrl}" class="btn btn-danger btn-sm">Delete</a>
                        </div>
                    </div>
                </article>
            `;
        }

        function updateFeedings(query) {
            fetch(`${searchUrl}?query=${encodeURIComponent(query)}`)
                .then(response => response.json())
                .then(items => {
                    feedingCountBadge.textContent = `${items.length} feedings`;

                    if (items.length === 0) {
                        feedingGrid.innerHTML = '<p style="grid-column: 1 / -1;">No feedings found.</p>';
                        return;
                    }

                    feedingGrid.innerHTML = items.map((item, index) => renderFeedingCard(item, index)).join('');
                })
                .catch(() => {
                    feedingGrid.innerHTML = '<p style="grid-column: 1 / -1;">Search failed. Please try again.</p>';
                });
        }

        feedingSearchInput.addEventListener('input', () => {
            window.clearTimeout(feedingSearchTimer);
            feedingSearchTimer = window.setTimeout(() => updateFeedings(feedingSearchInput.value), 200);
        });
    </script>
}
