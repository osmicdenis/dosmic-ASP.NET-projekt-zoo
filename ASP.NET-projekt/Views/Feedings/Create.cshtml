@model FeedingCreateEditViewModel

@{
    ViewData["Title"] = Model.Id == 0 ? "Create Feeding" : "Edit Feeding";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <h2>@ViewData["Title"]</h2>
            <hr />

            <form asp-action="@(Model.Id == 0 ? "Create" : "Edit")" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                @if (Model.Id != 0)
                {
                    <input type="hidden" asp-for="Id" />
                }

                @await Html.PartialAsync("_AutocompleteDropdown", new AutocompleteDropdownViewModel
                {
                    FieldName = nameof(Model.AnimalId),
                    LabelText = "Animal",
                    Placeholder = "Search and select an animal",
                    SearchUrl = Url.Action("SearchAnimals", "Feedings") ?? string.Empty,
                    SelectedValue = Model.AnimalId == 0 ? string.Empty : Model.AnimalId.ToString(),
                    SelectedText = Model.AvailableAnimals.FirstOrDefault(a => a.Id == Model.AnimalId)?.Name,
                    ValueField = "id",
                    LabelField = "name",
                    QueryParam = "query",
                    MinCharacters = 0,
                    IsRequired = true,
                    HelpText = "Start typing or leave it empty to browse all animals."
                })
                <span asp-validation-for="AnimalId" class="text-danger"></span>

                @await Html.PartialAsync("_AutocompleteDropdown", new AutocompleteDropdownViewModel
                {
                    FieldName = nameof(Model.FoodId),
                    LabelText = "Food",
                    Placeholder = "Search and select a food",
                    SearchUrl = Url.Action("SearchFoods", "Feedings") ?? string.Empty,
                    SelectedValue = Model.FoodId == 0 ? string.Empty : Model.FoodId.ToString(),
                    SelectedText = Model.AvailableFoods.FirstOrDefault(f => f.Id == Model.FoodId)?.Name,
                    ValueField = "id",
                    LabelField = "name",
                    QueryParam = "query",
                    MinCharacters = 0,
                    IsRequired = true,
                    HelpText = "Start typing or leave it empty to browse all foods."
                })
                <span asp-validation-for="FoodId" class="text-danger"></span>

                @await Html.PartialAsync("_DateTimeControl", new DateTimeControlViewModel
                {
                    FieldName = nameof(Model.FeedingTime),
                    LabelText = "Feeding Time",
                    Placeholder = "Select feeding date and time",
                    SelectedValue = Model.FeedingTime != default ? Model.FeedingTime : null,
                    IsRequired = true,
                    EnableTime = true,
                    Format = "Y-m-d H:i",
                    TimeFormat = "H:i",
                    HelpText = "Select the date and time for this feeding."
                })
                <span asp-validation-for="FeedingTime" class="text-danger"></span>

                <div class="form-group">
                    <button type="submit" class="btn btn-primary">@(Model.Id == 0 ? "Create" : "Update")</button>
                    <a href="@Url.Action("Index")" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
