@model ASP.NET_projekt.ViewModels.AutocompleteDropdownViewModel

<div class="form-group mb-3 autocomplete-control"
     data-autocomplete-control
     data-search-url="@Model.SearchUrl"
     data-value-field="@Model.ValueField"
     data-label-field="@Model.LabelField"
     data-query-param="@Model.QueryParam"
     data-min-characters="@Model.MinCharacters">
    <label for="@(Model.FieldName)__input" class="form-label">@Model.LabelText</label>

    <div class="autocomplete-shell">
        <input type="hidden"
               name="@Model.FieldName"
               id="@Model.FieldName"
               value="@Model.SelectedValue"
               data-autocomplete-value />

        <input type="text"
               id="@(Model.FieldName)__input"
               class="form-control autocomplete-input"
               placeholder="@Model.Placeholder"
               value="@Model.SelectedText"
               autocomplete="off"
               data-autocomplete-input />

        <button type="button" class="autocomplete-clear btn btn-outline-secondary btn-sm" data-autocomplete-clear>
            Clear
        </button>

        <div class="autocomplete-dropdown list-group" data-autocomplete-dropdown hidden></div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.HelpText))
    {
        <small class="form-text text-muted">@Model.HelpText</small>
    }
</div>