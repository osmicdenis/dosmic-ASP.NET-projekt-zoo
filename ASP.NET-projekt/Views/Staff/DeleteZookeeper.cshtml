@model ZookeeperCreateEditViewModel

@{
    ViewData["Title"] = "Delete Zookeeper";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <h2>Delete Zookeeper</h2>
            <hr />

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="alert alert-warning" role="alert">
                <strong>Warning:</strong> Are you sure you want to delete this zookeeper? This action cannot be undone.
            </div>

            @if ((ViewBag.EnclosureCount as int? ?? 0) > 0)
            {
                <div class="alert alert-danger" role="alert">
                    This zookeeper is currently assigned to @ViewBag.EnclosureCount enclosure(s), so deletion is disabled.
                </div>
            }

            <div class="card mb-4">
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-3">Name:</dt>
                        <dd class="col-sm-9">@Model.FirstName @Model.LastName</dd>

                        <dt class="col-sm-3">Years of Experience:</dt>
                        <dd class="col-sm-9">@Model.YearsOfExperience</dd>

                        <dt class="col-sm-3">Date of Employment:</dt>
                        <dd class="col-sm-9">@Model.DateOfEmployment.ToShortDateString()</dd>

                        <dt class="col-sm-3">Assigned Enclosures:</dt>
                        <dd class="col-sm-9">@ViewBag.EnclosureCount</dd>
                    </dl>
                </div>
            </div>

            <form asp-action="DeleteZookeeper" method="post" class="d-inline">
                <input type="hidden" asp-for="Id" />
                @if ((ViewBag.EnclosureCount as int? ?? 0) > 0)
                {
                    <button type="submit" class="btn btn-danger" disabled>Delete</button>
                }
                else
                {
                    <button type="submit" class="btn btn-danger">Delete</button>
                }
                <a href="@Url.Action("Index")" class="btn btn-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>
