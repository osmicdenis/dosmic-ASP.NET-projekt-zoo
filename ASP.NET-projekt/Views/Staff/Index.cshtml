@model IEnumerable<ASP.NET_projekt.ViewModels.StaffListItemViewModel>
@{
    ViewData["Title"] = "All Staff";
}

<section class="entity-page">
    <header class="entity-header">
        <div>
            <h1 class="entity-title">All Staff</h1>
            <p class="entity-subtitle">Browse all zookeepers and veterinarians, then open a profile for full details.</p>
        </div>
        <div class="entity-actions">
            <a href="@Url.Action("CreateZookeeper", "Staff")" class="btn btn-primary btn-sm">Add Zookeeper</a>
            <a href="@Url.Action("CreateVeterinarian", "Staff")" class="btn btn-primary btn-sm">Add Veterinarian</a>
            <span class="entity-count-badge" id="staffCountBadge">@Model.Count() staff members</span>
        </div>
    </header>

    <div style="margin-bottom: 20px; max-width: 420px;">
        <input type="text" id="staffSearchInput" class="form-control" placeholder="Search staff by name, role, or title...">
    </div>

    <div class="entity-grid" id="staffGrid">
        @{ var index = 0; }
        @foreach (var staff in Model)
        {
            <article class="entity-card" style="animation-delay:@(index * 40)ms">
                <div class="entity-card__head">
                    <h2 class="entity-card__title">@staff.FullName</h2>
                    <p class="entity-card__subtitle">@staff.Subtitle</p>
                </div>

                <div class="entity-card__chips">
                    <span class="entity-chip entity-chip--role">@staff.Role</span>
                    <span class="entity-chip @staff.StatusClass">@staff.StatusText</span>
                </div>

                <dl class="entity-card__meta">
                    @foreach (var item in staff.MetaItems)
                    {
                        <div class="entity-meta-row">
                            <dt class="entity-meta-label">@item.Key</dt>
                            <dd class="entity-meta-value">@item.Value</dd>
                        </div>
                    }
                </dl>

                <div class="entity-card__footer" style="display: flex; gap: 8px; justify-content: space-between;">
                    <a class="card-link entity-link" asp-controller="Staff" asp-action="Details" asp-route-role="@staff.Role.ToLowerInvariant()" asp-route-id="@staff.Id">View details</a>
                    <div>
                        <a href="@Url.Action(staff.Role == "Zookeeper" ? "EditZookeeper" : "EditVeterinarian", "Staff", new { id = staff.Id })" class="btn btn-warning btn-sm">Edit</a>
                        <a href="@Url.Action(staff.Role == "Zookeeper" ? "DeleteZookeeper" : "DeleteVeterinarian", "Staff", new { id = staff.Id })" class="btn btn-danger btn-sm">Delete</a>
                    </div>
                </div>
            </article>
            index++;
        }
    </div>
</section>

@section Scripts {
    <script>
        const staffSearchInput = document.getElementById('staffSearchInput');
        const staffGrid = document.getElementById('staffGrid');
        const staffCountBadge = document.getElementById('staffCountBadge');
        const searchUrl = '@Url.Action("Search", "Staff")';
        const detailsUrlTemplate = '@Url.Action("Details", "Staff", new { role = "__role__", id = "__id__" })';
        const editZookeeperUrlTemplate = '@Url.Action("EditZookeeper", "Staff", new { id = "__id__" })';
        const deleteZookeeperUrlTemplate = '@Url.Action("DeleteZookeeper", "Staff", new { id = "__id__" })';
        const editVeterinarianUrlTemplate = '@Url.Action("EditVeterinarian", "Staff", new { id = "__id__" })';
        const deleteVeterinarianUrlTemplate = '@Url.Action("DeleteVeterinarian", "Staff", new { id = "__id__" })';
        let staffSearchTimer = null;

        function escapeHtml(value) {
            return String(value)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');
        }

        function renderStaffCard(item, index) {
            const detailsUrl = detailsUrlTemplate.replace('__role__', item.role.toLowerCase()).replace('__id__', item.id);
            const editUrl = item.role === 'Zookeeper'
                ? editZookeeperUrlTemplate.replace('__id__', item.id)
                : editVeterinarianUrlTemplate.replace('__id__', item.id);
            const deleteUrl = item.role === 'Zookeeper'
                ? deleteZookeeperUrlTemplate.replace('__id__', item.id)
                : deleteVeterinarianUrlTemplate.replace('__id__', item.id);

            const metaMarkup = item.metaItems.map(meta => `
                <div class="entity-meta-row">
                    <dt class="entity-meta-label">${escapeHtml(meta.key)}</dt>
                    <dd class="entity-meta-value">${escapeHtml(meta.value)}</dd>
                </div>
            `).join('');

            return `
                <article class="entity-card" style="animation-delay:${index * 40}ms">
                    <div class="entity-card__head">
                        <h2 class="entity-card__title">${escapeHtml(item.fullName)}</h2>
                        <p class="entity-card__subtitle">${escapeHtml(item.subtitle)}</p>
                    </div>

                    <div class="entity-card__chips">
                        <span class="entity-chip entity-chip--role">${escapeHtml(item.role)}</span>
                        <span class="entity-chip ${item.statusClass}">${escapeHtml(item.statusText)}</span>
                    </div>

                    <dl class="entity-card__meta">
                        ${metaMarkup}
                    </dl>

                    <div class="entity-card__footer" style="display: flex; gap: 8px; justify-content: space-between;">
                        <a class="card-link entity-link" href="${detailsUrl}">View details</a>
                        <div>
                            <a href="${editUrl}" class="btn btn-warning btn-sm">Edit</a>
                            <a href="${deleteUrl}" class="btn btn-danger btn-sm">Delete</a>
                        </div>
                    </div>
                </article>
            `;
        }

        function updateStaff(query) {
            fetch(`${searchUrl}?query=${encodeURIComponent(query)}`)
                .then(response => response.json())
                .then(items => {
                    staffCountBadge.textContent = `${items.length} staff members`;

                    if (items.length === 0) {
                        staffGrid.innerHTML = '<p style="grid-column: 1 / -1;">No staff found.</p>';
                        return;
                    }

                    staffGrid.innerHTML = items.map((item, index) => renderStaffCard(item, index)).join('');
                })
                .catch(() => {
                    staffGrid.innerHTML = '<p style="grid-column: 1 / -1;">Search failed. Please try again.</p>';
                });
        }

        staffSearchInput.addEventListener('input', () => {
            window.clearTimeout(staffSearchTimer);
            staffSearchTimer = window.setTimeout(() => updateStaff(staffSearchInput.value), 200);
        });
    </script>
}
