@model VeterinarianCreateEditViewModel

@{
    ViewData["Title"] = "Delete Veterinarian";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <h2>Delete Veterinarian</h2>
            <hr />

            <div class="alert alert-warning" role="alert">
                <strong>Warning:</strong> Are you sure you want to delete this veterinarian? This action cannot be undone.
            </div>

            <div class="card mb-4">
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-3">Name:</dt>
                        <dd class="col-sm-9">@Model.FirstName @Model.LastName</dd>

                        <dt class="col-sm-3">Medical Records:</dt>
                        <dd class="col-sm-9">@ViewBag.RecordCount</dd>
                    </dl>
                </div>
            </div>

            <form asp-action="DeleteVeterinarian" method="post" class="d-inline">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger">Delete</button>
                <a href="@Url.Action("Index")" class="btn btn-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>
